# Frontend environment template (local development)
# ⚠️ Never store secrets in frontend env vars: values are exposed in browser builds.

# App
NODE_ENV=development
PORT=3000
APP_NAME=pellet-heizung-frontend
APP_URL=http://localhost:3000

# API
API_BASE_URL=http://localhost:8080/api

# Auth (optional/public values only)
AUTH_ENABLED=false
AUTH_TOKEN_STORAGE_KEY=pellet_token
OAUTH_CLIENT_ID=
OAUTH_AUTHORITY=
OAUTH_REDIRECT_URI=http://localhost:3000/callback
OAUTH_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Feature flags
FEATURE_DASHBOARD=true
FEATURE_NOTIFICATIONS=false
FEATURE_DEBUG_TOOLS=false

# Logging / debug
LOG_LEVEL=info
ENABLE_CONSOLE_LOGS=true
ENABLE_MOCK_API=false

# Framework-specific env prefixes (use only what your frontend stack supports)
VITE_API_BASE_URL=http://localhost:8080/api
REACT_APP_API_BASE_URL=http://localhost:8080/api
VUE_APP_API_BASE_URL=http://localhost:8080/api
